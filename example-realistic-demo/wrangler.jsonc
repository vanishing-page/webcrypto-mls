{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "webcrypto-mls",
    "main": "index.ts",
    "compatibility_date": "2026-07-27",
    "observability": {
        "enabled": true
    },
    // `run_worker_first` is true, not just the `/api/*` routes, because
    // the security headers are set by the Worker and an asset served
    // without touching it would carry none. The Worker forwards
    // everything that is not an API path to the ASSETS binding
    // unchanged, so single-page-application handling still applies.
    "assets": {
        "binding": "ASSETS",
        "directory": "./public",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "ROOM",
                "class_name": "Room"
            },
            {
                "name": "REGISTRY",
                "class_name": "RoomRegistry"
            }
        ]
    },
    // Socket upgrades per client address. The numbers are copied in
    // `room-logic.ts` as UPGRADE_LIMIT and UPGRADE_PERIOD_SECONDS, where
    // a test holds them against honest reconnect backoff. Change both.
    "ratelimits": [
        {
            "name": "UPGRADE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 100,
                "period": 60
            }
        }
    ],
    "exports": {
        "Room": {
            "type": "durable-object",
            "storage": "sqlite"
        },
        "RoomRegistry": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    }
}
